extends: default

ignore: |
  .test/
  artifacts/

rules:
  document-start: disable
  # promtool input-series lines are long by nature.
  line-length:
    max: 160
    ignore: |
      prometheus/tests/
  truthy:
    check-keys: false      # GitHub Actions uses the bare key "on:"
  comments:
    min-spaces-from-content: 1
  indentation:
    indent-sequences: consistent
