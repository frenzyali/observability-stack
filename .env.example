# Copy to .env and change the password. .env is gitignored.
# These values are placeholders, not real credentials.
COMPOSE_PROJECT_NAME=obs-stack

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# Host ports (always bound to 127.0.0.1). Change these if a port is taken.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
SAMPLE_APP_PORT=8000

# Fault-injection API on the sample app (/chaos), used by scripts/chaos.sh.
SAMPLE_APP_CHAOS_ENABLED=true
